      "dot": "amber",
      "title": "Atlas database",
      "items": [
        "Database farmengage_poc on M0 MyFreeCluster in AWS us-east-1",
        "John Deere and Raven are simulated vehicle labels",
        "syncJobs stores a short TASKDATA fragment, not a full ISO-XML file"
      ]
    },
