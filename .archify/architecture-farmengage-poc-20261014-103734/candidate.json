    {
      "dot": "cyan",
      "title": "Operator path",
      "items": [
        "The browser loads the MapLibre page from the gateway",
        "app.js polls /api/snapshot and sends work orders"
      ]
    },
    {
      "dot": "emerald",
      "title": "One local process",
      "items": [
        "server.ts listens on 127.0.0.1:8787 and starts the simulator",
        "Notes are embedded with voyage-4, then queried with $vectorSearch",
        "This process does not call api.farmengage.com"
      ]
    },
